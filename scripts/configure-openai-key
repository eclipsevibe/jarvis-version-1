#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="$HOME/.config/jarvis"
KEY_FILE="$CONFIG_DIR/openai.env"
mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"
read -r -s -p "Paste the OpenAI API key (input hidden): " API_KEY
printf '\n'
if [[ -z "$API_KEY" ]]; then
  echo "No key entered; nothing changed." >&2
  exit 1
fi
umask 077
printf 'OPENAI_API_KEY=%s\n' "$API_KEY" > "$KEY_FILE"
unset API_KEY
chmod 600 "$KEY_FILE"

# Activate the installed desktop-layer HUD while preserving other desklets.
CURRENT_DESKLETS="$(gsettings get org.cinnamon enabled-desklets)"
ENABLED_DESKLETS="$(python3 - "$CURRENT_DESKLETS" <<'PY'
import ast, sys
try: desklets=ast.literal_eval(sys.argv[1])
except Exception: desklets=[]
entry='jarvis-hud@local:1:0:0'
if not any(item.startswith('jarvis-hud@local:') for item in desklets):
    desklets.append(entry)
print('['+', '.join(repr(item) for item in desklets)+']')
PY
)"
gsettings set org.cinnamon enabled-desklets "$ENABLED_DESKLETS"
systemctl --user daemon-reload
systemctl --user restart jarvis.service
echo "Key saved securely. Jarvis restarted; fixed commands remain local, conversation uses OpenAI when available and falls back to the local model."
