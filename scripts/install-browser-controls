#!/usr/bin/env python3
"""Install local native-host manifests for a user-loaded Chrome extension."""
import argparse
import base64
import hashlib
import json
from pathlib import Path
import re
import shlex

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('--extension-id',help='Optional override for a separately packaged extension')
args=parser.parse_args()
root=Path(__file__).resolve().parents[1]
manifest=json.loads((root/'browser-extension/manifest.json').read_text())
if args.extension_id:
    extension_id=args.extension_id
elif manifest.get('key'):
    digest=hashlib.sha256(base64.b64decode(manifest['key'])).digest()[:16].hex()
    extension_id=''.join(chr(ord('a')+int(c,16)) for c in digest)
else:
    parser.error('Load the unpacked extension in Chrome, then rerun with --extension-id ID from chrome://extensions.')
if not re.fullmatch('[a-p]{32}',extension_id):parser.error('Use the 32-letter extension ID shown by Chrome.')
for browser,folder in [('chrome','google-chrome'),('chromium','chromium')]:
    wrapper=root/'browser-extension'/('native-'+browser)
    wrapper.write_text('#!/bin/sh\nexec '+shlex.join([str(root/'.venv/bin/python'),str(root/'browser_native_host.py'),'--browser',browser])+' "$@"\n')
    wrapper.chmod(0o755)
    destination=Path.home()/'.config'/folder/'NativeMessagingHosts'
    destination.mkdir(parents=True,exist_ok=True)
    (destination/'com.jarvis.browser_control.json').write_text(json.dumps(dict(
        name='com.jarvis.browser_control',description='Jarvis local tab controls',path=str(wrapper),type='stdio',
        allowed_origins=['chrome-extension://'+extension_id+'/']),indent=2)+'\n')
print('Native hosts installed.\n'
      'In Chrome, open chrome://extensions and enable Developer mode.\n'
      'Choose Load unpacked and select '+str(root/'browser-extension')+'\n'
      'Expected extension ID: '+extension_id+'\n'
      'Restart Jarvis, then reload the browser extension if it was already open.')
