#!/usr/bin/env python3
"""Connect playlist read access with Spotify Authorization Code + PKCE."""
import argparse
import base64
import hashlib
import json
from http.server import HTTPServer, BaseHTTPRequestHandler
from pathlib import Path
import secrets
import sys
import time
from urllib.parse import urlencode, urlsplit, parse_qs
import webbrowser

sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
import requests
from spotify_control import private_json

REDIRECT='http://127.0.0.1:8766/callback'
parser=argparse.ArgumentParser(description=__doc__,epilog='Register '+REDIRECT+' in your Spotify developer app redirect URIs. Only playlist read permissions are requested.')
parser.add_argument('--client-id',required=True,help='Your Spotify developer app Client ID (not its secret)')
args=parser.parse_args()
if not __import__('re').fullmatch('[A-Za-z0-9]{16,128}',args.client_id):parser.error('Invalid Spotify app Client ID.')
verifier=secrets.token_urlsafe(64)
challenge=base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip('=')
state=secrets.token_urlsafe(32)
result={}
class Handler(BaseHTTPRequestHandler):
    def log_message(self,*_):pass
    def do_GET(self):
        parsed=urlsplit(self.path);query=parse_qs(parsed.query)
        valid=(parsed.path=='/callback' and secrets.compare_digest(query.get('state',[''])[0],state))
        if valid:
            if query.get('code'):result['code']=query['code'][0]
            else:result['error']='Spotify authorization was declined.'
        body=b'Spotify response received. You may return to the terminal.' if valid else b'Invalid callback.'
        self.send_response(200 if valid else 400)
        self.send_header('Content-Type','text/plain');self.send_header('Content-Length',str(len(body)))
        self.send_header('Cache-Control','no-store');self.end_headers();self.wfile.write(body)
try:
    with HTTPServer(('127.0.0.1',8766),Handler) as server:
        server.timeout=1
        url='https://accounts.spotify.com/authorize?'+urlencode(dict(client_id=args.client_id,response_type='code',redirect_uri=REDIRECT,scope='playlist-read-private playlist-read-collaborative',state=state,code_challenge_method='S256',code_challenge=challenge))
        print('Opening Spotify sign-in. If it does not open, visit:\n'+url,flush=True)
        webbrowser.open(url)
        deadline=time.monotonic()+300
        while not result and time.monotonic()<deadline:server.handle_request()
    if 'code' not in result:raise RuntimeError(result.get('error','Sign-in timed out. Run the command again.'))
    response=requests.post('https://accounts.spotify.com/api/token',data=dict(grant_type='authorization_code',client_id=args.client_id,code=result['code'],redirect_uri=REDIRECT,code_verifier=verifier),timeout=15,allow_redirects=False)
    if response.status_code!=200:raise RuntimeError('Spotify did not complete sign-in. Check your app Client ID and registered redirect URI.')
    token=response.json()
    if not token.get('access_token') or not token.get('refresh_token'):raise RuntimeError('Spotify did not return the required credentials.')
    token.update(client_id=args.client_id,expires_at=time.time()+token['expires_in'])
    private_json(Path.home()/'.config/jarvis/spotify-oauth.json',token)
    print('Spotify library connected. Jarvis can now read your saved playlists. No playlist editing permissions were requested.')
except (OSError,requests.RequestException,ValueError,RuntimeError) as exc:
    parser.exit(1,str(exc)+'\n')
